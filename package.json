{
  "name": "navego",
  "version": "1.8.1",
  "private": true,
  "license": "MIT",
  "description": "Navego — local browser control bridge with Supabase-powered workflows and automation.",
  "type": "module",
  "scripts": {
    "build:shared": "node scripts/pack/build-shared.ts",
    "build:local": "node scripts/pack/build-local.ts",
    "build:extension": "node scripts/pack/build-extension.ts",
    "build:extension:watch": "tsc -p tsconfig.extension.json --watch",
    "types": "tsc --noEmit -p tsconfig.shared.json && tsc --noEmit -p tsconfig.local.json && tsc --noEmit -p tsconfig.extension.json && tsc --noEmit -p tsconfig.tooling.json",
    "pretest": "npm run audit && npm run biome && npm run build:shared && npm run build:local && npm run build:extension && node scripts/pack/pack-mcp.ts",
    "audit": "node scripts/audit/audit-cheats.ts",
    "biome": "biome check .",
    "test": "node --test --test-timeout=120000 --test-reporter=dot tests/**/*.test.ts",
    "test:unit": "node --test tests/extension/protocol.test.ts tests/vm/workflow-dsl.test.ts",
    "test:browser": "python tests/browser_extension_test.py",
    "benchmark:semantic": "node scripts/verify/semantic-baseline.ts --runs=3",
    "benchmark:ledger": "node scripts/bench/goal-ledger-benchmark.ts --runs=3 --iterations=1000",
    "benchmark:proof": "node scripts/bench/proof-engine-benchmark.ts --runs=30",
    "benchmark:latency": "node scripts/bench/latency-benchmark.ts --runs=30",
    "bridge": "node scripts/dev/start-bridge.ts",
    "diagnose:mcp": "node scripts/dev/mcp-connection-diagnostics.ts",
    "migrate": "node scripts/release/apply-migrations.ts",
    "store": "python scripts/release/build-store-package.py",
    "icons": "python scripts/dev/draw-icon.py",
    "gates:refresh": "node scripts/verify/gates.ts --refresh",
    "check": "npm run types && node scripts/verify/type-debt.ts && node scripts/verify/check.ts",
    "scope": "node scripts/verify/scope.ts",
    "scope:diff": "node scripts/verify/scope-check.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
