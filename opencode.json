{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "providers": {
    "nvidia2": {
      "name": "NVIDIA (second account)",
      "canonical": "nvidia",
      "settings": {
        "apiKey": "{file:~/.config/opencode/nvidia-api-key-2}"
      },
      "models": {
        "minimaxai/minimax-m3.1-flash": {
          "name": "MiniMax M3.1 Flash (account 2)"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project",
          ".",
          "--agent-interface",
          "tools",
          "--open-web-dashboard",
          "false"
        ],
        "cwd": ".",
        "timeout": {
          "startup": 180000,
          "catalog": 60000,
          "execution": 600000
        }
      },
      "supabase": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@supabase/mcp-server-supabase@latest",
          "--features=database",
          "--project-ref=nenmkmtvjremqphfqnfw"
        ],
        "timeout": 60000
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "oauth": {}
      },
      "navego": {
        "type": "local",
        "command": "navego",
        "args": ["local"],
        "timeout": {
          "startup": 60000,
          "catalog": 60000,
          "execution": 600000
        }
      }
    }
  },
  "plugins": [
    "{env:USERPROFILE}/.config/opencode/plugins.project/workflow",
    "{env:USERPROFILE}/.config/opencode/plugins.project/navego"
  ]
}
