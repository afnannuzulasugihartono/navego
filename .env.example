# .env - copy to .env (gitignored) for local use; never commit real values.
# @last-edited: 2026-11-17 21:30 UTC+7.
# @title: .env - the environment the local driver, the bridge cloud meter and ops scripts read.
# @state: the bridge cloud URL is the one secret the local meter depends on; everything else is optional.
# @dependencies: none stated.

# Supabase project (see supabase/config.toml for the self-hosted default).

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The local bridge calls NAVEGO_CLOUD_URL once per session to open the meter and once at close to report it; the one-line cloud call this file previously documented as NAVEGO_MCP_BASE_URL is the same service.

NAVEGO_CLOUD_URL=https://nenmkmtvjremqphfqnfw.supabase.co/functions/v1/navego-bridge
NAVEGO_BRIDGE_PORT=9451
NAVEGO_BRIDGE_DEBUG_FRAMES=
NAVEGO_BRIDGE_TRUST_MS=

# Static token instead of the OAuth sign-in.
# Handy for automation and CI (one token, one machine, no callback URL).
# A set token wins over the OAuth login file.
# Create one in the dashboard; never commit it.

NAVEGO_MCP_TOKEN=
NAVEGO_MCP_DEVICE_NAME=opera
NAVEGO_MCP_USER_IDS=
NAVEGO_MCP_EMAILS=

# Ops scripts (see scripts/doctor.ts and docs/operations.md).

SUPABASE_PROJECT_REF=nenmkmtvjremqphfqnfw
NAVEGO_DIAGNOSTIC_BEARER=

# CORS allowlist for edge functions (comma-separated).
# Empty = fail-closed defaults (this extension + the OAuth consent page).

CORS_ALLOWED_ORIGINS=
